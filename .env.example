# Cronus configuration (.env)
# ---------------------------------------------------------------------------
# Copy this file to `.env` at the repo root and edit. The server (and the debug
# bot) load it at startup; variables already set in the real environment win.
# Lines starting with # are comments. Values may be quoted.
#
# NOTE: relative paths resolve against the server's working directory, which
# depends on how you launch it — absolute paths are the safe choice.

# --- Network -----------------------------------------------------------------
# The IP/hostname advertised to clients. Keep 127.0.0.1 for local play;
# set your LAN or public IP (or DDNS name) so friends can connect.
CRONUS_HOST=127.0.0.1

# Number of channels (1-8). Login is port 8484; channels take 7575, 7576, ...
# and the cash shop takes the port right after the last channel.
CRONUS_CHANNELS=2
#CRONUS_LOGIN_PORT=8484
#CRONUS_CHANNEL_PORT=7575

# --- Processes ---------------------------------------------------------------
# run-server.bat starts three processes: World (the hub the other two register
# with), Login, and Channel. They talk gRPC on the loopback interface; nothing
# here is reachable from the internet. Change these only when the processes run
# on different machines (bind the World to a LAN address and point the others at it).
#CRONUS_WORLD_BIND=127.0.0.1
#CRONUS_WORLD_PORT=8585
#CRONUS_WORLD_URI=http://127.0.0.1:8585
#CRONUS_WORLD_NAME=Cronus

# The airship timetable is the World's (every channel follows it): a 15-minute
# cycle, boarding open for the first 10 minutes, the Balrog raid on every flight.
#CRONUS_AIRSHIP_CYCLE_MIN=15
#CRONUS_AIRSHIP_BOARDING_MIN=10
#CRONUS_AIRSHIP_BALROG_CHANCE=1.0

# --- Storage -----------------------------------------------------------------
# MySQL 8 is the standard store: one database shared by every server process.
# Defaults: 127.0.0.1:3306, database Cronus186, user root, password root. The
# database and its tables are created on first start; setup.bat asks for these.
#CRONUS_DB_HOST=127.0.0.1
#CRONUS_DB_PORT=3306
#CRONUS_DB_NAME=Cronus186
#CRONUS_DB_USER=root
#CRONUS_DB_PASSWORD=root

# Alternatives: a full connection string, `sqlite` (one file next to the Channel
# executable, or CRONUS_DB_FILE), or `memory` (wiped on exit, and private to each
# process - the Login and the Channel would not share accounts: tests only). On the
# first MySQL start an old cronus.db next to the Channel executable is imported once
# and renamed cronus.db.imported.
#CRONUS_DB=server=localhost;database=Cronus186;user=root;password=YOURPW
#CRONUS_DB=sqlite
#CRONUS_DB=memory
#CRONUS_DB_FILE=D:\cronus\save.db

# --- Game data ---------------------------------------------------------------
# wz_xml tree: map/NPC/mob/skill/item data. Without it there are no spawns.
# Game data, in preference order (set ONE of these):
#   CRONUS_GAMEDATA — a gamedata.db built from the client's .wz files (recommended):
#                     dotnet run --project src/Cronus.Ingest -- <client dir>
#   CRONUS_CLIENT   — the client folder itself; gamedata.db is built from it on first
#                     boot automatically and reused afterwards
#   CRONUS_WZ       — a classic loose wz_xml dump tree (legacy fallback)
#CRONUS_GAMEDATA=gamedata.db
#CRONUS_CLIENT=../Client/MapleStory_v186
CRONUS_WZ=DevTools/cronus-wz

# Script root ({root}/npc/{id}.js, quest/, portal/, reactor/).
CRONUS_SCRIPTS=scripts

# drop_data.sql dump: mob drop tables.
CRONUS_DROPS=../Reference/JMSv186/sql/drop_data.sql

# shops + shopitems + reactordrops SQL dump: NPC shops and reactor drops.
CRONUS_SHOPS=../Reference/JMSv186/sql/init_data_set.sql

# --- Login -------------------------------------------------------------------
# Unknown accounts are created on first login (default on; 0/false/off disables).
CRONUS_AUTO_REGISTER=1

# --- Gameplay ----------------------------------------------------------------
# Starting map for new characters.
#CRONUS_STARTMAP=100000000

# Rate multipliers.
#CRONUS_RATE_EXP=1.0
#CRONUS_RATE_DROP=1.0
#CRONUS_RATE_MESO=1.0

# Cash-shop allowance floor in NX (0 disables the floor).
#CRONUS_NX=300000

# Per-line damage cap. Off by default (client-reported damage is applied as-is, like the
# reference server). 1/true/on enables the clamp; the ceiling defaults to 50000000.
#CRONUS_DAMAGE_CAP_ENABLED=0
#CRONUS_DAMAGE_CAP=50000000

# --- Diagnostics -------------------------------------------------------------
# 1 = log every sent/received packet as hex (large logs; great for debugging).
#CRONUS_DEBUG=1

# --- Debug bot (src/Cronus.Debug.Bot) ---------------------------------------
#CRONUS_BOT_COUNT=4
#CRONUS_BOT_HOST=127.0.0.1
#CRONUS_BOT_PORT=8484
# 0 = protocol bots only; 1 = also launch real client windows.
#CRONUS_BOT_LAUNCH=0
# Path to a client exe for CRONUS_BOT_LAUNCH=1.
#CRONUS_CLIENT_PATH=../Client/MapleStory_v186/JMS_v186.1_L.exe
